{"nodes": [{"id": "apps_web_app_icon_noxes_app_icon", "label": "Noxes App Icon (icon.svg)", "file_type": "image", "source_file": "apps/web/app/icon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vector app icon/favicon for the Noxes web app. Design intent is a dark, modern tech aesthetic with a single high-contrast orange brand accent, conveying the 'N' of Noxes as a clean geometric monogram that reads at small favicon sizes."}, {"id": "apps_web_app_icon_n_monogram", "label": "N Monogram Mark", "file_type": "concept", "source_file": "apps/web/app/icon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The central 'N' letterform is the primary brand mark, representing Noxes. Drawn as a single continuous path with square line caps and miter joins for a sharp, technical look."}, {"id": "apps_web_app_icon_dark_rounded_canvas", "label": "Dark Rounded-Square Canvas", "file_type": "concept", "source_file": "apps/web/app/icon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 512x512 rounded-square background filled with near-black #111315 (rx=16) establishes a dark-theme foundation typical of developer/security tooling."}, {"id": "apps_web_app_icon_inner_border_frame", "label": "Inner Border Frame", "file_type": "concept", "source_file": "apps/web/app/icon.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An inset rectangular outline at x=24,y=24 (464x464, rx=8, 8px stroke #414548) frames the mark, adding a subtle layered/inset depth cue against the dark canvas."}, {"id": "apps_web_app_icon_orange_accent_color", "label": "Orange Brand Accent (#E83708)", "file_type": "concept", "source_file": "apps/web/app/icon.svg", "source_location": null, "source_url": null, "captured_at": null, "a