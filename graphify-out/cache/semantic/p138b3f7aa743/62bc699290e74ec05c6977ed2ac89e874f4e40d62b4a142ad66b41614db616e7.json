{"nodes": [{"id": "apps_web_public_brand_social_launch_square_square_poster", "label": "Noxes Launch Square Poster (1:1)", "file_type": "image", "source_file": "apps/web/public/brand/social/launch-square.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "1080x1080 launch poster from the same campaign as the portrait/story variants. Mark + NOXES, 'INDEPENDENT SOFTWARE STUDIO' kicker, 'BUILD WHAT COMES NEXT.' with NEXT. in lime, body copy, lime 'STARTING WITH FIVEM' pill, footer motto. Navy gradient (#171F3F -> #101426 -> #0B1020), grid, indigo glow, indigo + lime accent curves. Purpose: square social launch graphic (feeds etc.)."}, {"id": "apps_web_public_brand_social_launch_square_noxes_brand_identity", "label": "Noxes Brand Identity", "file_type": "concept", "source_file": "apps/web/public/brand/social/launch-square.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "'Noxes' positioned as an 'INDEPENDENT SOFTWARE STUDIO' creating 'thoughtful software for people shaping their own digital worlds', with 'NOXES for FiveM' as the first project.", "rationale": "Launch assets consistently frame Noxes as an independent studio and lead with FiveM as the first concrete project, establishing scope and credibility."}, {"id": "apps_web_public_brand_social_launch_square_brand_mark", "label": "Noxes Logo Mark", "file_type": "concept", "source_file": "apps/web/public/brand/social/launch-square.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Brand mark: a rounded-corner indigo (#5B72F2) bracket frame enclosing a lime (#D8F36A) zig-zag 'N' with a small lime dot at top-right; reused across all assets, sometimes enlarged."}, {"id": "apps_web_public_brand_social_launch_square_color_palette", "label": "Noxes Color Palette", "file_type": "concept", "source_file": "apps/web/public/brand/social/launch-square.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Dark navy gradient backgrounds (#20294A/#171F3F -> #101426 -> #0B1020), indigo/periwinkle (#5B72F2, #8E9DFF) glow and accents, lime (#D8F36A) accent, off-white (#F4F5FB) display text, muted blue-grey (#BBC3DF, #929BB9) body/footer text."}, {"id": "apps_web_public_brand_social_launch_square_typography_system", "label": "Noxes Typography System", "file_type": "concept", "source_file": "apps/web/public/brand/social/launch-square.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Space Grotesk for bold display headlines, IBM Plex Mono for kickers/labels ('INDEPENDENT SOFTWARE STUDIO', 'STARTING WITH FIVEM', footer motto), Inter for body copy."}, {"id": "apps_web_public_brand_social_launch_square_build_what_comes_next", "label": "Build What Comes Next (tagline)", "file_type": "concept", "source_file": "apps/web/public/brand/social/launch-square.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Primary campaign tagline 'BUILD WHAT COMES NEXT', set as large display type with the final word 'NEXT.' highlighted in lime."}, {"id": "apps_web_public_brand_social_launch_square_tools_for_builders_motto", "label": "Tools for the people who build (motto)", "file_type": "concept", "source_file": "apps/web/public/brand/social/launch-square.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Secondary brand motto 'TOOLS FOR THE PEOPLE WHO BUILD.' rendered in monospaced capitals as a footer line."}, {"id": "apps_web_public_brand_social_launch_square_starting_with_fivem", "label": "Starting with FiveM (product positioning)", "file_type": "concept", "source_file": "apps/web/public/brand/social/launch-square.