{"nodes": [{"id": "scripts_transition_runbook_transition_runbook", "label": "Auth Transition Runbook", "file_type": "document", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_transition_runbook_auth_allow_anon", "label": "AUTH_ALLOW_ANON flag", "file_type": "concept", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults to true so existing deploys keep working: headerless requests are treated as an anonymous user bound to legacy dev-org, while invalid/expired tokens still get 401. Flip to false only after the updated web and desktop builds are deployed; rollback is just flipping back to true."}, {"id": "scripts_transition_runbook_agent_legacy_ok", "label": "AGENT_LEGACY_OK flag", "file_type": "concept", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When true, a tokenless agent WS hello is accepted only if the device's stored pairingTokenHash is NULL (paired before tokens existed). Flipping to false requires every device to have a hash and a matching session token."}, {"id": "scripts_transition_runbook_clerk_bearer_tokens", "label": "Clerk-verified bearer tokens", "file_type": "concept", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_transition_runbook_per_org_tenancy", "label": "Per-org tenancy", "file_type": "concept", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_transition_runbook_agent_session_tokens", "label": "Agent session tokens", "file_type": "concept", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_transition_runbook_dev_org_tenant", "label": "Legacy dev-org tenant", "file_type": "concept", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orphaned tenant that anonymous callers write into while AUTH_ALLOW_ANON=true; no real customer data is reachable because every Clerk-authenticated caller gets their own org, but anonymous writes are not blocked."}, {"id": "scripts_transition_runbook_frozen_node_cli_agent", "label": "Frozen Node CLI agent (apps/agent)", "file_type": "rationale", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLI is frozen and never persists or sends session tokens, so new pairings are dead once a claim stores a hash (tokenless hello gets INVALID_TOKEN). Treat the CLI as EOL for new pairings and direct users to the desktop installer; ops SQL can null hashes to extend existing devices."}, {"id": "scripts_transition_runbook_db_migration", "label": "DB migration (app_users table)", "file_type": "concept", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_transition_runbook_omniroute_api_key_rename", "label": "OMNI_KEY \u2192 OMNIROUTE_API_KEY rename", "file_type": "concept", "source_file": "scripts/TRANSITION-RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "scripts_transition_runbook_omniroute_api_key_rename", "target": "vps_omni_tunnel_setup_omniroute", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": 