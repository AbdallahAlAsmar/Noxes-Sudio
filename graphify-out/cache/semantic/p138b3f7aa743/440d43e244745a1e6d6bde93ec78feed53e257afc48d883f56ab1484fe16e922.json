{"nodes": [{"id": "brand_identity_v2_brand_direction_v2_brand_direction", "label": "NOXES Brand Direction V2", "file_type": "document", "source_file": "brand/identity-v2/BRAND_DIRECTION_V2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brand_identity_v2_brand_direction_v2_brand_promise", "label": "Brand Promise", "file_type": "rationale", "source_file": "brand/identity-v2/BRAND_DIRECTION_V2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make complex systems easier to shape while keeping people in control. The name has no invented historical or Latin origin; meaning derives from this mission and the product truth of reading resources, staging a diff, asking review, and keeping a recovery checkpoint."}, {"id": "brand_identity_v2_brand_direction_v2_brand_architecture", "label": "Brand Architecture", "file_type": "concept", "source_file": "brand/identity-v2/BRAND_DIRECTION_V2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOXES is the enduring parent identity; the first product is 'NOXES for FiveM'; future products get their own names endorsed by NOXES. Identity must not rely on FiveM imagery and must not imply an unannounced roadmap."}, {"id": "brand_identity_v2_brand_direction_v2_warm_signal_palette", "label": "Warm Signal Palette", "file_type": "rationale", "source_file": "brand/identity-v2/BRAND_DIRECTION_V2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replace cobalt and lime: graphite #1D1F20, warm white #F4F0E8, deep ember #B7472F (light surfaces), brighter ember #F28A62 (dark surfaces). Avoid generic neon gradients and stock AI/gaming motifs; keep status colors independent and verify contrast before applying tokens."}, {"id": "brand_identity_v2_brand_direction_v2_controlled_passage", "label": "Controlled Passage (recommended symbol route)", "file_type": "rationale", "source_file": "brand/identity-v2/BRAND_DIRECTION_V2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several separate inputs resolve through one deliberate opening into a clear route; complexity becomes actionable while a person controls the transition. Recommended because it is broad enough for every future product. See concept-01-passage.svg."}, {"id": "brand_identity_v2_brand_direction_v2_human_checkpoint", "label": "Human Checkpoint (symbol route)", "file_type": "rationale", "source_file": "brand/identity-v2/BRAND_DIRECTION_V2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A continuous route changes direction at a distinct control point before proceeding; expresses the human review that precedes a consequential change. See concept-02-checkpoint.svg."}, {"id": "brand_identity_v2_brand_direction_v2_recoverable_change", "label": "Recoverable Change (symbol route)", "file_type": "rationale", "source_file": "brand/identity-v2/BRAND_DIRECTION_V2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A path connects a before-state and an after-state around a stable return point; expresses confidence to make changes because recovery remains possible. See concept-03-return-path.svg."}, {"id": "brand_identity_v2_brand_direction_v2_noxes_for_fivem", "label": "NOXES for FiveM", "file_type": "concept", "source_file": "brand/identity-v2/BRAND_DIRECTION_V2.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "brand_identity_v2_brand_direction_v2_controlled_passage", "target": "brand_identity_v2_concept_board_controlled_passage", "relation": "semantically_similar_to", "confidence": "INFERRED", 